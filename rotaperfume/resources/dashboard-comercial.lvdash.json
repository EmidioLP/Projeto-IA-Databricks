{
  "datasets": [
    {
      "name": "ds_vendas",
      "displayName": "Vendas",
      "queryLines": [
        "SELECT data_pedido, ano, canal, cliente_id, razao_social, segmento, cidade, marca, categoria, pedido_id, receita, margem, devolucao \n",
        "FROM fato_vendas \n"
      ],
      "columns": [
        {
          "displayName": "Receita Total",
          "description": "Soma da receita (líquida - inclui devolução, exclui cancelado)",
          "expression": "SUM(`receita`)"
        },
        {
          "displayName": "Margem Total",
          "description": "Soma da margem (receita menos custo)",
          "expression": "SUM(`margem`)"
        },
        {
          "displayName": "Pedidos",
          "description": "Número de pedidos distintos",
          "expression": "COUNT(DISTINCT `pedido_id`)"
        },
        {
          "displayName": "Ticket Médio",
          "description": "Receita total dividida pelo número de pedidos distintos",
          "expression": "SUM(`receita`) / NULLIF(COUNT(DISTINCT `pedido_id`), 0)"
        },
        {
          "displayName": "Margem %",
          "description": "Margem como percentual da receita (escala 0-100)",
          "expression": "SUM(`margem`) * 100.0 / NULLIF(SUM(`receita`), 0)"
        }
      ]
    },
    {
      "name": "ds_top_clientes",
      "displayName": "Top clientes",
      "queryLines": [
        "SELECT cliente_id, razao_social, segmento, cidade, SUM(receita) AS receita \n",
        "FROM fato_vendas \n",
        "GROUP BY cliente_id, razao_social, segmento, cidade \n",
        "ORDER BY receita DESC \n",
        "LIMIT 20 \n"
      ]
    }
  ],
